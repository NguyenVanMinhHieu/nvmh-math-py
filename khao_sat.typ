#set page(paper: "a4", margin: (x: 1.8cm, y: 1.8cm))
#set text(font: "New Computer Modern", size: 11pt, lang: "vi")

#align(center)[
  #text(16pt, weight: "bold", fill: blue.darken(40%))[BÁO CÁO KHẢO SÁT HÀM SỐ]
]

#v(0.2cm)

== 1. Biểu thức Giải tích
#rect(width: 100%, stroke: 0.5pt + gray.lighten(50%), inset: 10pt, radius: 4pt)[
  - *Hàm số khảo sát:* $y = (x^2 + 2 x - 3)/(x + 1)$
  - *Đạo hàm cấp một:* $y' = (x^2 + 2 x + 5)/(x^2 + 2 x + 1)$
]

== 2. Bảng biến thiên (Chuẩn Sư phạm THPT)
#align(center)[
  #table(
    columns: (1.8cm, 4.2cm, 0.9cm, 4.2cm),
    align: center + horizon,
    fill: (col, row) => if row == 0 { gray.lighten(85%) } else { none },
    stroke: (col, row) => (
      top: if row == 0 { 1pt + black } else { 0.5pt + gray },
      bottom: if row == 2 { 1pt + black } else { 0.5pt + gray },
      right: if col == 0 { 1pt + black } else { none },
      left: none
    ),
    [$x$],
    [#grid(columns: (1fr, 1fr), align: (left, right), [$-infinity$], [$-1^-$])],
    [$-1$],
    [#grid(columns: (1fr, 1fr), align: (left, right), [$-1^+$], [$+infinity$])],
    [$y'$],
    [$+$],
    [$||$],
    [$+$],
    [$y$],
    [
      #grid(
        columns: (1fr, 1fr, 1fr),
        align: (left + bottom, center + horizon, right + top),
        [$-infinity$], [$arrow.tr$], [$+infinity$]
      )
    ],
    [],
    [
      #grid(
        columns: (1fr, 1fr, 1fr),
        align: (left + bottom, center + horizon, right + top),
        [$-infinity$], [$arrow.tr$], [$+infinity$]
      )
    ]
  )
]

